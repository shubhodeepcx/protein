# Comma-separated allowed CORS origins. REQUIRED — leave unset to deny all origins.
# Local dev:
CORS_ORIGINS=http://localhost:3000

# Contact address submitted with every EBI NCBI BLAST job (P8). EBI requires
# one so they can reach the operator of a misbehaving client.
#
# REQUIRED for BLAST to work at all. Verified live on 2026-08-24: EBI REJECTS
# the fallback address proteolens@users.noreply.github.com outright, answering
# HTTP 400 "Please enter a valid email address". So an unset BLAST_CONTACT_EMAIL
# does not mean "degraded but working" — every BLAST submission fails. UniRef
# similar-proteins is unaffected; it needs no contact address.
#
# Set it to a mailbox you actually read: EBI is entitled to block a client they
# cannot contact.
BLAST_CONTACT_EMAIL=
