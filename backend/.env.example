# Comma-separated allowed CORS origins. REQUIRED — leave unset to deny all origins.
# Local dev:
CORS_ORIGINS=http://localhost:3000

# Contact address submitted with every EBI NCBI BLAST job (P8). EBI requires
# one so they can reach the operator of a misbehaving client.
#
# Unset, the backend falls back to proteolens@users.noreply.github.com and logs
# a warning on every submission. That fallback is fine for local development;
# set a reachable mailbox before deploying, because EBI is entitled to block a
# client they cannot contact.
BLAST_CONTACT_EMAIL=
