#
# mmCIF null markers in the source categories.
#
# `?` means "value unknown" and `.` means "not applicable". MMCIF2Dict hands
# both straight through as strings, so a naive read returns the literal "?" as
# the organism and the UI renders "Organism: ?". Here the first two keys of the
# fallback chain are null and the real organism sits in the third, which pins
# both behaviours at once: skip the nulls, keep walking the chain.
#
data_TEST
#
_entry.id   TEST
#
_entity_src_gen.entity_id                       1
_entity_src_gen.pdbx_src_id                     1
_entity_src_gen.pdbx_gene_src_scientific_name   ?
#
_entity_src_nat.entity_id                   1
_entity_src_nat.pdbx_src_id                 1
_entity_src_nat.pdbx_organism_scientific    .
#
_pdbx_entity_src_syn.entity_id             1
_pdbx_entity_src_syn.pdbx_src_id           1
_pdbx_entity_src_syn.organism_scientific   'Gallus gallus'
#
loop_
_atom_site.group_PDB
_atom_site.id
_atom_site.type_symbol
_atom_site.label_atom_id
_atom_site.label_alt_id
_atom_site.label_comp_id
_atom_site.label_asym_id
_atom_site.label_entity_id
_atom_site.label_seq_id
_atom_site.pdbx_PDB_ins_code
_atom_site.Cartn_x
_atom_site.Cartn_y
_atom_site.Cartn_z
_atom_site.occupancy
_atom_site.B_iso_or_equiv
_atom_site.auth_seq_id
_atom_site.auth_asym_id
_atom_site.pdbx_PDB_model_num
ATOM 1  N N  . GLY A ? 1 ? 1.000 1.000 1.000 1.0 20.00 1 A 1
ATOM 2  C CA . GLY A ? 1 ? 2.000 1.000 1.000 1.0 20.00 1 A 1
ATOM 3  C C  . GLY A ? 1 ? 3.000 1.000 1.000 1.0 20.00 1 A 1
ATOM 4  O O  . GLY A ? 1 ? 3.500 2.000 1.000 1.0 20.00 1 A 1
ATOM 5  N N  . ALA A ? 2 ? 4.000 1.000 1.000 1.0 20.00 2 A 1
ATOM 6  C CA . ALA A ? 2 ? 5.000 1.000 1.000 1.0 20.00 2 A 1
ATOM 7  C C  . ALA A ? 2 ? 6.000 1.000 1.000 1.0 20.00 2 A 1
ATOM 8  O O  . ALA A ? 2 ? 6.500 2.000 1.000 1.0 20.00 2 A 1
