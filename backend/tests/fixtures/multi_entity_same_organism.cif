#
# A two-entity mmCIF whose entities come from the SAME organism, spelled with
# different capitalisation on each row (RCSB depositions are not consistent
# about this) — and named a third time in `_entity_src_nat`.
#
# A homo-complex must still render as one plain species name, with no separator
# and no "and N more" tail, exactly as a single-entity file does. That makes
# this the guard against the multi-organism join leaking into the common case.
#
data_TEST
#
_entry.id   TEST
#
loop_
_entity.id
_entity.type
_entity.pdbx_description
1 polymer 'Subunit alpha'
2 polymer 'Subunit beta'
#
loop_
_entity_src_gen.entity_id
_entity_src_gen.pdbx_src_id
_entity_src_gen.pdbx_gene_src_scientific_name
1 1 'Homo sapiens'
2 2 'HOMO SAPIENS'
#
_entity_src_nat.entity_id                  1
_entity_src_nat.pdbx_src_id                1
_entity_src_nat.pdbx_organism_scientific   'homo sapiens'
#
loop_
_atom_site.group_PDB
_atom_site.id
_atom_site.type_symbol
_atom_site.label_atom_id
_atom_site.label_alt_id
_atom_site.label_comp_id
_atom_site.label_asym_id
_atom_site.label_entity_id
_atom_site.label_seq_id
_atom_site.pdbx_PDB_ins_code
_atom_site.Cartn_x
_atom_site.Cartn_y
_atom_site.Cartn_z
_atom_site.occupancy
_atom_site.B_iso_or_equiv
_atom_site.auth_seq_id
_atom_site.auth_asym_id
_atom_site.pdbx_PDB_model_num
ATOM 1  N N  . GLY A 1 1 ? 1.000 1.000 1.000 1.0 20.00 1 A 1
ATOM 2  C CA . GLY A 1 1 ? 2.000 1.000 1.000 1.0 20.00 1 A 1
ATOM 3  C C  . GLY A 1 1 ? 3.000 1.000 1.000 1.0 20.00 1 A 1
ATOM 4  O O  . GLY A 1 1 ? 3.500 2.000 1.000 1.0 20.00 1 A 1
ATOM 5  N N  . ALA B 2 1 ? 11.000 1.000 1.000 1.0 20.00 1 B 1
ATOM 6  C CA . ALA B 2 1 ? 12.000 1.000 1.000 1.0 20.00 1 B 1
ATOM 7  C C  . ALA B 2 1 ? 13.000 1.000 1.000 1.0 20.00 1 B 1
ATOM 8  O O  . ALA B 2 1 ? 13.500 2.000 1.000 1.0 20.00 1 B 1
