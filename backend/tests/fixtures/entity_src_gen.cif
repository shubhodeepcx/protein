#
# Minimal recombinant-expression mmCIF: three residues on one chain.
#
# The organism lives in `_entity_src_gen` (the shape RCSB ships for any
# recombinantly expressed entry) and NOT in `_entity_src_nat`, so this fixture
# pins the first key of the `_MMCIF_ORGANISM_KEYS` fallback chain. `_struct` is
# deliberately absent so the test also proves organism is read independently of
# the header BioPython does populate.
#
data_TEST
#
_entry.id   TEST
#
_entity_src_gen.entity_id                          1
_entity_src_gen.pdbx_src_id                        1
_entity_src_gen.pdbx_gene_src_scientific_name      'Homo sapiens'
_entity_src_gen.pdbx_host_org_scientific_name      'Escherichia coli'
